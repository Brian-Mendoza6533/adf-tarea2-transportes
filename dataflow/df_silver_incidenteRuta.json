{
	"name": "df_silver_incidenteRuta",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidente_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidenteRuta_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(iif(isNull(IncidenteId) || trim(IncidenteId) == '', 'ERROR_ID', IncidenteId)),",
				"          RutaHistoricaId = upper(substring(trim(iif(isNull(RutaHistoricaId) || trim(RutaHistoricaId) == '', 'ERROR_RUTA', RutaHistoricaId)), 1, 5)),",
				"          EsPrincipal = toBoolean(iif(lower(trim(EsPrincipal)) == 'true', '1', '0'))) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          RutaHistoricaId,",
				"          EsPrincipal",
				"     )) ~> sink1"
			]
		}
	}
}