{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(DemandaId = trim(iif(isNull(DemandaId), 'ERROR_ID', DemandaId)),",
				"          RutaHistoricaId = upper(replace(trim(RutaHistoricaId), 'RUTA ', 'R-')),",
				"          ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          Franja = upper(trim(Franja)),",
				"          Metodo = upper(trim(Metodo))) ~> derivedColumn1",
				"derivedColumn4 derive(ValidacionesTarjeta = toInteger(iif(isNull(ValidacionesTarjeta) || trim(ValidacionesTarjeta) == '', '0', ValidacionesTarjeta)),",
				"          Descensos = toInteger(iif(isNull(Descensos) || trim(Descensos) == '', '0', Descensos)),",
				"          DemandaNoAtendida = toInteger(iif(isNull(DemandaNoAtendida) || trim(DemandaNoAtendida) == '', '0', DemandaNoAtendida))) ~> derivedColumn3",
				"derivedColumn3 split(!isNull(FechaServicio) && !isNull(ValidacionesTarjeta) && !isNull(Descensos) && !isNull(DemandaNoAtendida),",
				"     disjoint: false) ~> split1@(aceptados, rechazados)",
				"derivedColumn1 derive(FechaServicio = toDate(coalesce(iif(instr(FechaServicio, '/') > 0, toString(toDate(FechaServicio, 'dd/MM/yyyy')), FechaServicio), '1900-01-01'), 'yyyy-MM-dd')) ~> derivedColumn4",
				"split1@aceptados aggregate(groupBy(DemandaId),",
				"     FechaServicio = first(FechaServicio),",
				"          RutaHistoricaId = first(RutaHistoricaId),",
				"          ParadaHistoricaId = first(ParadaHistoricaId),",
				"          Franja = first(Franja),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          Descensos = first(Descensos),",
				"          DemandaNoAtendida = first(DemandaNoAtendida),",
				"          Metodo = first(Metodo)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}