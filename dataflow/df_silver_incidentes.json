{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(iif(isNull(IncidenteId) || trim(IncidenteId) == '', 'ERROR_ID', IncidenteId)),",
				"          TipoIncidente = upper(trim(iif(isNull(TipoIncidente) || trim(TipoIncidente) == '', 'DESCONOCIDO', TipoIncidente))),",
				"          Severidad = upper(trim(iif(isNull(Severidad) || trim(Severidad) == '', 'DESCONOCIDA', Severidad))),",
				"          VehiculoId = upper(trim(iif(isNull(VehiculoId) || trim(VehiculoId) == '' || upper(trim(VehiculoId)) == 'NULL', 'SIN_VEHICULO', VehiculoId))),",
				"          Descripcion = trim(iif(isNull(Descripcion) || trim(Descripcion) == '', 'SIN_DESCRIPCION', Descripcion)),",
				"          FechaHoraInicio = iif(\r",
				"    isNull(FechaHoraInicio) || trim(FechaHoraInicio) == '', \r",
				"    toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss'), \r",
				"    toTimestamp(\r",
				"        iif(\r",
				"            instr(FechaHoraInicio, '/') > 0, \r",
				"            concat(toString(toDate(FechaHoraInicio, 'dd/MM/yyyy')), ' 00:00:00'), \r",
				"            FechaHoraInicio\r",
				"        ), \r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    )\r",
				"),",
				"          FechaHoraFin = iif(\r",
				"    isNull(FechaHoraFin) || trim(FechaHoraFin) == '', \r",
				"    toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss'), \r",
				"    toTimestamp(\r",
				"        iif(\r",
				"            instr(FechaHoraFin, '/') > 0, \r",
				"            concat(toString(toDate(FechaHoraFin, 'dd/MM/yyyy')), ' 00:00:00'), \r",
				"            FechaHoraFin\r",
				"        ), \r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    )\r",
				"),",
				"          FechaHoraRegistro = iif(\r",
				"    isNull(FechaHoraRegistro) || trim(FechaHoraRegistro) == '', \r",
				"    toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss'), \r",
				"    toTimestamp(\r",
				"        iif(\r",
				"            instr(FechaHoraRegistro, '/') > 0, \r",
				"            concat(toString(toDate(FechaHoraRegistro, 'dd/MM/yyyy')), ' 00:00:00'), \r",
				"            FechaHoraRegistro\r",
				"        ), \r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    )\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}