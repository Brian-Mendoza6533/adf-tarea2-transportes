{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(iif(isNull(IncidenteId) || trim(IncidenteId) == '', 'ERROR_ID', IncidenteId)),",
				"          TipoIncidente = upper(trim(iif(isNull(TipoIncidente) || trim(TipoIncidente) == '', 'DESCONOCIDO', TipoIncidente))),",
				"          Severidad =      upper(trim(iif(isNull(Severidad) || trim(Severidad) == '', 'DESCONOCIDA', Severidad))),",
				"          VehiculoId = upper(trim(iif(isNull(VehiculoId) || trim(VehiculoId) == '' || upper(trim(VehiculoId)) == 'NULL', 'SIN_VEHICULO', VehiculoId))),",
				"          Descripcion =      trim(iif(isNull(Descripcion) || trim(Descripcion) == '', 'SIN_DESCRIPCION', Descripcion))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraInicio =      toTimestamp(iif(instr(FechaHoraInicio, 'T') > 0, substring(FechaHoraInicio, 1, 19), iif(instr(FechaHoraInicio, '/') > 0, toString(toDate(FechaHoraInicio, 'dd/MM/yyyy')), iif(instr(FechaHoraInicio, ' ') > 0, substring(FechaHoraInicio, 1, 19), '1900-01-01 00:00:00'))), 'yyyy-MM-dd HH:mm:ss'),",
				"          FechaHoraFin =      toTimestamp(iif(instr(FechaHoraFin, 'T') > 0, substring(FechaHoraFin, 1, 19), iif(instr(FechaHoraFin, '/') > 0, toString(toDate(FechaHoraFin, 'dd/MM/yyyy')), iif(instr(FechaHoraFin, ' ') > 0, substring(FechaHoraFin, 1, 19), '1900-01-01 00:00:00'))), 'yyyy-MM-dd HH:mm:ss'),",
				"          FechaHoraRegistro = toTimestamp(iif(isNull(FechaHoraRegistro) || trim(FechaHoraRegistro) == '' || instr(FechaHoraRegistro, 'T') > 0, '1900-01-01 00:00:00', iif(instr(FechaHoraRegistro, '/') > 0, concat(toString(toDate(FechaHoraRegistro, 'dd/MM/yyyy')), ' 00:00:00'), concat(FechaHoraRegistro, ' 00:00:00'))), 'yyyy-MM-dd HH:mm:ss')) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}